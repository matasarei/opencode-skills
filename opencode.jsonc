{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/prism-ml/bonsai-27b",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        // Recommended Model 1: Prism Bonsai 27B (best on Apple Silicon in MLX variant, 32–48 GB RAM)
        "prism-ml/bonsai-27b": {
          "name": "Prism Bonsai 27B",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "reasoning_effort": "none"
          },
          "variants": {
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
            "off": {
              "reasoning_effort": "none"
            },
            "on": {
              "reasoning_effort": "medium"
            }
          }
        },
        // Recommended Model 2: Qwen3 Coder 30B (more capable, but requires more memory)
        "qwen/qwen3-coder-30b": {
          "name": "Qwen3 Coder 30B",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "reasoning_effort": "none"
          },
          "variants": {
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
            "off": {
              "reasoning_effort": "none"
            },
            "on": {
              "reasoning_effort": "medium"
            }
          }
        },
        // Lower-End Hardware: Qwen3.5 9B (8–12 GB VRAM, reasonable context and output length)
        "qwen/qwen3.5-9b": {
          "name": "Qwen3.5 9B",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "reasoning_effort": "none"
          },
          "variants": {
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
            "off": {
              "reasoning_effort": "none"
            },
            "on": {
              "reasoning_effort": "medium"
            }
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    }
  },
  "agent": {
    "build": {
      "temperature": 0
    },
    "plan": {
      "temperature": 0,
      "permission": {
        "edit": {
          "*.md": "allow",
          "**/*.md": "allow",
          ".tasks/**": "allow",
          "plans/**": "allow"
        }
      }
    }
  }
}
